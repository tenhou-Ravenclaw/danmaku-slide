rules_version = '2';

service cloud.firestore {
  match /databases/{db}/documents {

    // 匿名認証でも authed() は true。観客にも匿名サインインを入れる前提。
    function authed() { return request.auth != null; }

    /**
     * 匿名ではない人。運営だけがこれを満たす。
     *
     * イベントとトラックは当日まで残るものなので、端末を変えたら失う匿名のままでは
     * 運用に耐えない。トラックに触れるのは本人確認できる運営だけ。
     * 登壇者と観客は匿名で読むだけなので authed() で足りる。
     */
    function signedIn() {
      return authed() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /events/{eventId} {

      function eventPath() { return /databases/$(db)/documents/events/$(eventId); }

      // イベントを操作できるのは、作成者本人か、引き継ぎコードで登録された運用者。
      function isEventOperator() {
        return authed() && (
          resource.data.ownerUid == request.auth.uid ||
          exists(/databases/$(db)/documents/events/$(eventId)/operators/$(request.auth.uid))
        );
      }

      allow get: if authed();
      allow list: if authed() && request.query.limit <= 50;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','heldOn','ownerUid','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn() && isEventOperator()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','heldOn']);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // 引き継ぎコードの置き場。誰からも読めない。Rules の get() だけが参照する。
      match /private/{doc} {
        allow read: if false;
        allow write: if authed()
          && get(eventPath()).data.ownerUid == request.auth.uid;
      }

      // 運営を手伝う人。イベント単位で登録する。
      match /operators/{uid} {
        allow read: if false;
        allow create: if authed()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['code'])
          && request.resource.data.code ==
               get(/databases/$(db)/documents/events/$(eventId)/private/handoff).data.code;
        allow update, delete: if false;
      }

      match /tracks/{trackId} {

        function trackPath() {
          return /databases/$(db)/documents/events/$(eventId)/tracks/$(trackId);
        }

        /** 運営。イベントの持ち主と、手伝う人。 */
        function isEventStaff() {
          return authed() && (
            get(eventPath()).data.ownerUid == request.auth.uid ||
            exists(/databases/$(db)/documents/events/$(eventId)/operators/$(request.auth.uid))
          );
        }

        allow get: if authed();
        allow list: if authed() && request.query.limit <= 50;

        allow create: if signedIn()
          && get(eventPath()).data.ownerUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name','stopped','createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          // 既定は受付中。どちらで作るかは運営の道具の側で決める。
          // ここで縛るのは形だけにする。
          && request.resource.data.stopped is bool
          && request.resource.data.createdAt == request.time;

        /*
         * 変えられるのは受付の可否（stopped）と名前（name）だけ。createdAt は動かない。
         *
         * 名前を止めていたのは「動かす面を最小にする」ためで、QR の約束とは別だった。
         * 配るQRとリンクは trackId だけで出来ていて name を含まないので、
         * 名前が動いても配ったものはそのまま生きる。打ち間違えたトラックを
         * 消して作り直させるほうが、配り直しを招いて危ない。
         * （刷った紙に載った名前だけは古いまま残る。刷り直すかは運営の判断。）
         *
         * 形は作るときと同じものを要求する。name は常に文書にあるので、
         * 今回の更新で触ったかどうかに関わらず、結果の形だけを見れば足りる。
         *
         * 触れるのは運営だけ。登壇の開始と終了はこの道具の仕事ではないので、
         * 登壇者には書き込む先がひとつも無い。渡すリンクも合言葉を持たない。
         */
        allow update: if isEventStaff()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stopped','name']);

        allow delete: if signedIn() && get(eventPath()).data.ownerUid == request.auth.uid;

        match /comments/{commentId} {
          allow get: if authed();
          allow list: if authed() && request.query.limit <= 50;

          allow create: if authed()
            && request.resource.data.keys().hasOnly(['text','createdAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 60
            && request.resource.data.createdAt == request.time
            // 受付中でなければ受け付けない。開けるのも止めるのも運営。
            && get(trackPath()).data.stopped == false
            // 同じバッチで posters/{uid} も更新されていることを要求する = レート制限の強制
            && getAfter(/databases/$(db)/documents/events/$(eventId)/tracks/$(trackId)/posters/$(request.auth.uid))
                 .data.lastPostAt == request.time;

          allow update, delete: if false;
        }

        // 投稿者ごとの最終投稿時刻。2秒に1回しか更新できない。
        match /posters/{uid} {
          allow read: if false;
          allow create: if authed() && uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['lastPostAt'])
            && request.resource.data.lastPostAt == request.time;
          allow update: if authed() && uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['lastPostAt'])
            && request.resource.data.lastPostAt == request.time
            && request.time > resource.data.lastPostAt + duration.value(2, 's');
          allow delete: if false;
        }
      }
    }
  }
}
