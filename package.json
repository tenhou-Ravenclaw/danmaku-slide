{
  "name": "danmaku-slide",
  "private": true,
  "type": "module",
  "scripts": {
    "config": "node scripts/gen-config.mjs",
    "review": "node scripts/review.mjs",
    "dev": "firebase emulators:start",
    "lint:rules": "node scripts/lint-rules.mjs",
    "lint:secrets": "gitleaks git . --redact --verbose --no-banner",
    "lint": "npm run lint:rules && npm run lint:secrets",
    "test:rules": "firebase emulators:exec --only firestore --project danmaku-slide-test 'node test/rules.test.mjs'",
    "test:e2e": "node test/e2e.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy": "firebase deploy --only hosting,firestore:rules",
    "preview": "firebase hosting:channel:deploy preview --expires 7d"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.2.0",
    "firebase-tools": "^15.35.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
